        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "dataloader": "^2.2.2",
        "graphql-subscriptions": "^2.0.0",
        "graphql-upload": "^16.0.2",
        "redis": "^4.6.12",
        "winston": "^3.11.0",
        "dotenv": "^16.3.1",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
