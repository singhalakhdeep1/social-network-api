{
    "name": "social-network-api",
    "version": "2.0.0",
    "description": "Social network backend: GraphQL (Apollo Server 4) + subscriptions, tRPC, gRPC, MongoDB, Redis, Elasticsearch, Neo4j/JanusGraph social graph",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc && node scripts/copy-assets.js",
        "typecheck": "tsc --noEmit",
        "graph:sync": "tsx src/scripts/graphSync.ts",
        "search:reindex": "tsx src/scripts/reindexSearch.ts"
    },
    "keywords": [
        "graphql",
        "apollo",
        "subscriptions",
        "trpc",
        "grpc",
        "neo4j",
        "elasticsearch",
        "social-network"
    ],
    "dependencies": {
        "@apollo/server": "^4.11.2",
        "@elastic/elasticsearch": "^8.17.0",
        "@graphql-tools/schema": "^10.0.11",
        "@grpc/grpc-js": "^1.12.2",
        "@grpc/proto-loader": "^0.7.13",
        "@trpc/server": "^10.45.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dataloader": "^2.2.2",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "graphql": "^16.9.0",
        "graphql-query-complexity": "^1.0.0",
        "graphql-redis-subscriptions": "^2.6.1",
        "graphql-subscriptions": "^2.0.0",
        "graphql-upload-minimal": "^1.6.1",
        "graphql-ws": "^5.16.0",
        "gremlin": "^3.7.3",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.8.1",
        "neo4j-driver": "^5.26.0",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.9.16",
        "otplib": "^12.0.1",
        "prom-client": "^15.1.3",
        "stripe": "^17.4.0",
        "uuid": "^11.0.3",
        "validator": "^13.12.0",
        "winston": "^3.17.0",
        "ws": "^8.18.0",
        "xss": "^1.0.15",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.17.6",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.17",
        "@types/validator": "^13.12.2",
        "@types/ws": "^8.5.13",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.14",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
