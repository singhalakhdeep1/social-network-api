# Copy to .env and adjust. Every value has a development default in src/config/env.ts.

# Server
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
LOG_LEVEL=info
LOG_TO_FILES=false

# MongoDB (primary store)
MONGODB_URI=mongodb://localhost:27017/social-network-api

# Redis (cache, rate-limit buckets, multi-instance subscriptions). Leave REDIS_URL empty to run without it.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Auth (JWT_SECRET and JWT_REFRESH_SECRET are required when NODE_ENV=production)
JWT_SECRET=change-me-access-secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=7d
# Comma-separated emails that are given the admin role on registration
ADMIN_EMAILS=
# AES key material for direct messages at rest
MESSAGE_ENCRYPTION_KEY=change-me-message-key

# GraphQL limits and uploads
MAX_QUERY_DEPTH=10
MAX_QUERY_COMPLEXITY=1500
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Rate limiting (token bucket per user / IP; separate bucket for login, register, password reset)
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=5
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_PER_MINUTE=10

# Elasticsearch (optional; MongoDB text search is used when unset)
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Social graph provider: mongo | neo4j | janusgraph
GRAPH_PROVIDER=mongo
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
JANUSGRAPH_URL=ws://localhost:8182/gremlin

# gRPC (internal service API)
GRPC_ENABLED=true
GRPC_PORT=50051

# Email (messages are logged when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Social Network <noreply@socialnetwork.local>

# Stripe (creator subscriptions and tips; recorded without charging when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Background work
ENABLE_METRICS=true
ENABLE_CRON=true
